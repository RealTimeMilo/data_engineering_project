# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit real secrets.

AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=local/airflow:3.2.1
BUILD_ID=local-dev

# Optional: point Airflow at an external Postgres instead of the bundled one.
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:<password>@<host>:5432/postgres
# AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://postgres:<password>@<host>:5432/postgres
# AIRFLOW__CELERY__BROKER_URL=amqp://<user>:<password>@<host>:5672//

DAG_BUNDLE_CONFIG_LIST='[{"name": "git_dags", "classpath": "airflow.providers.git.bundles.git.GitDagBundle", "kwargs": {"git_conn_id": "my_git_connection", "tracking_ref": "main", "subdir": "dags", "refresh_interval": 300}}]'

# --- WorkOS AuthKit SSO for the EC2 Airflow (optional) ----------------------
# Leave blank to keep the default local DB login (airflow / airflow).
# See README "WorkOS AuthKit SSO (EC2 Airflow)".
WORKOS_CLIENT_ID=
WORKOS_CLIENT_SECRET=
WORKOS_AUTHKIT_DOMAIN=
WORKOS_SSO_PROVIDER_NAME=workos
WORKOS_DEFAULT_ROLE=Viewer
WORKOS_ADMIN_EMAILS=
# Public URL of the Airflow UI, used to build the OAuth redirect URI.
# AIRFLOW__API__BASE_URL=http://<alb-dns>
