AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=local/airflow:3.2.1
BUILD_ID=local-dev

# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:REDACTED@database-1.cr6um202gaa1.us-east-2.rds.amazonaws.com/postgres
# AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://postgres:REDACTED@database-1.cr6um202gaa1.us-east-2.rds.amazonaws.com/postgres
# AIRFLOW__CELERY__BROKER_URL=amqp://macbook-admin:REDACTED@localhost:5672//

DAG_BUNDLE_CONFIG_LIST='[{"name": "git_dags", "classpath": "airflow.providers.git.bundles.git.GitDagBundle", "kwargs": {"git_conn_id": "my_git_connection", "tracking_ref": "main", "subdir": "dags", "refresh_interval": 300}}]'

# --- WorkOS AuthKit SSO for the EC2 Airflow (optional) ----------------------
# Leave blank to keep the default local DB login (airflow / airflow).
# See README "WorkOS AuthKit SSO (EC2 Airflow)".
WORKOS_CLIENT_ID=
WORKOS_CLIENT_SECRET=
WORKOS_AUTHKIT_DOMAIN=
WORKOS_SSO_PROVIDER_NAME=workos
WORKOS_DEFAULT_ROLE=Viewer
WORKOS_ADMIN_EMAILS=
# Public URL of the Airflow UI, used to build the OAuth redirect URI.
# Example: http://sde-airflow-dev-alb-1234567890.us-east-2.elb.amazonaws.com
AIRFLOW__WEBSERVER__BASE_URL=http://sde-airflow-dev-alb-1792962926.us-east-2.elb.amazonaws.com